{
  "name": "creativecorvidstylelibrary",
  "version": "1.0.0",
  "description": "A component and style library for building creative applications with Vue 3",
  "type": "module",
  "license": "MIT",
  "author": "Jonathan Fuller",
  "main": "./dist/creative-corvid-library.umd.js",
  "module": "./dist/creative-corvid-library.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/creative-corvid-library.es.js",
      "require": "./dist/creative-corvid-library.umd.js",
      "types": "./dist/types/index.d.ts"
    }
  },
  "files": [
    "dist/**"
  ],
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.13",
    "pinia": "^3.0.3",
    "dayjs": "^1.11.13",
    "maska": "^3.1.1",
    "primevue": "^4.3.1",
    "@fortawesome/fontawesome-svg-core": "^6.2.1",
    "@fortawesome/free-brands-svg-icons": "^6.2.1",
    "@fortawesome/free-solid-svg-icons": "^6.2.1",
    "@fortawesome/vue-fontawesome": "^3.0.2",
    "@primeuix/themes": "^1.0.0",
    "primeicons": "^7.0.0",
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.24",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.5.0",
    "autoprefixer": "^10.4.21",
    "jsdom": "^26.1.0",
    "postcss": "^8.4.21",
    "postcss-import": "^16.1.0",
    "postcss-nested": "^6.2.0",
    "prettier": "^3.3.3",
    "prettier-eslint": "16.4.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "2.2.10",
    "sass": "^1.89.0"
  },
  "postcss": {
    "plugins": {
      "autoprefixer": {}
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
